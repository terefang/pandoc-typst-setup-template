#!/usr/bin/env -S just --justfile
#
#
# https://github.com/casey/just/releases/download/1.40.0/just-1.40.0-x86_64-unknown-linux-musl.tar.gz

CURL := 'curl --progress-bar -L '
XDIR := justfile_directory()
XBIN := XDIR+"/xbin"
XLIB := XDIR+"/lib"
ABIN := XBIN+"/"+arch()+"-"+os()
XFNT := XDIR+"/fonts"
XTMPL := XDIR+"/templates"

ICONS_FONT := 'https://github.com/terefang/rpg-icons-font/raw/refs/heads/main/static/RpgGameIcons.otf'
ICONS_SET := 'https://github.com/terefang/rpg-icons-font/raw/refs/heads/main/static/diceset.typ'

## https://github.com/justrajdeep/fonts
## 0.2.0/

UTPM_RELEASE := 'v0.2.0'
UTPM_BASE := 'https://github.com/typst-community/utpm/releases/download/' + UTPM_RELEASE + '/utpm'
UTPM_ARCH := if arch() == "x86_64" { 'x86_64' } else { 'aarch64' }
UTPM_OS := if os() == "macos" { 'apple-darwin' } else { 'unknown-linux-musl' }

TYPST_RELEASE := 'v0.13.1'
TYPST_BASE := if os() == "linux" {
if arch() == "x86_64" {
  'https://github.com/typst/typst/releases/download/'+TYPST_RELEASE+'/typst-x86_64-unknown-linux-musl.tar.xz'
} else {
 'https://github.com/typst/typst/releases/download/'+TYPST_RELEASE+'/typst-aarch64-unknown-linux-musl.tar.xz'
}
} else if os() == "macos" {
if arch() == "x86_64" {
  'https://github.com/typst/typst/releases/download/'+TYPST_RELEASE+'/typst-x86_64-apple-darwin.tar.xz'
} else {
 'https://github.com/typst/typst/releases/download/'+TYPST_RELEASE+'/typst-aarch64-apple-darwin.tar.xz'
}
} else { "." }

PANDOC_RELEASE := '3.8'
PANDOC_BASE := if os() == "linux" {
if arch() == "x86_64" {
   'https://github.com/jgm/pandoc/releases/download/'+PANDOC_RELEASE+'/pandoc-'+PANDOC_RELEASE+'-linux-amd64.tar.gz'
} else {
  'https://github.com/jgm/pandoc/releases/download/'+PANDOC_RELEASE+'/pandoc-'+PANDOC_RELEASE+'-linux-arm64.tar.gz'
}
} else if os() == "macos" {
if arch() == "x86_64" {
   'https://github.com/jgm/pandoc/releases/download/'+PANDOC_RELEASE+'/pandoc-'+PANDOC_RELEASE+'-x86_64-macOS.zip'
} else {
  'https://github.com/jgm/pandoc/releases/download/'+PANDOC_RELEASE+'/pandoc-'+PANDOC_RELEASE+'-arm64-macOS.zip'
}
} else { "." }

LUCIOLE_BASE := 'https://luciole-vision.com/fonts/Luciole.zip'

NOTO_BASE := 'https://github.com/notofonts/latin-greek-cyrillic/releases/download/NotoSans-v2.015/NotoSans-v2.015.zip'
NOTO_LIST := 'NotoSans-BoldItalic.ttf ' \
    + 'NotoSans-Bold.ttf ' \
    + 'NotoSans-Italic.ttf ' \
    + 'NotoSans-Regular.ttf ' \
    + 'NotoSans-Black.ttf ' \
    + 'NotoSans-BlackItalic.ttf ' \
    + 'NotoSans-CondensedBlack.ttf ' \
    + 'NotoSans-CondensedBlackItalic.ttf ' \
    + 'NotoSans-CondensedBoldItalic.ttf ' \
    + 'NotoSans-CondensedBold.ttf ' \
    + 'NotoSans-CondensedItalic.ttf ' \
    + 'NotoSans-Condensed.ttf '

show:
    @echo 'XDG CACHE = {{ cache_directory() }} '
    @echo 'XDG CONFIG = {{ config_directory() }} '
    @echo 'XDG LOCAL CONFIG = {{ config_local_directory() }} '
    @echo 'XDG DATA = {{ data_directory() }} '
    @echo 'XDG LOCAL DATA = {{ data_local_directory() }} '
    @echo 'XDG EXECUTABLE = {{ executable_directory() }} '
    @echo 'HOME = {{ home_directory() }} '

fonts-list:
    {{XBIN}}/typst fonts --ignore-system-fonts --font-path {{XFNT}}

fonts-variants:
    {{XBIN}}/typst fonts --ignore-system-fonts --font-path {{XFNT}} --variants

fetch-utpm:
    #!/bin/sh
    mkdir -p {{XBIN}}/tmp
    {{CURL}} -o {{XBIN}}/tmp/utpm.tar.xz {{UTPM_BASE}}-{{UTPM_ARCH}}-{{UTPM_OS}}.tar.xz
    cd {{XBIN}}/tmp && tar -xf utpm.tar.xz
    cp $(find {{XBIN}}/tmp -type f -name utpm) {{XBIN}}/
    chmod +x {{XBIN}}/utpm
    rm -rf {{XBIN}}/tmp

fetch-typst:
    #!/bin/sh
    mkdir -p {{XBIN}}/tmp
    case "{{TYPST_BASE}}" in
        *.tar.*)
            {{CURL}} -o {{XBIN}}/tmp/typst.tar.xz {{TYPST_BASE}}
            (cd {{XBIN}}/tmp && tar -xf typst.tar.xz)
            ;;
        *.zip)
            {{CURL}} -o {{XBIN}}/tmp/typst.zip  {{TYPST_BASE}}
            (cd {{XBIN}}/tmp && unzip -o -j typst.zip)
        ;;
    esac
    case "{{os()}}" in
        windows)
            cp $(find {{XBIN}}/tmp -type f -name typst.exe) {{XBIN}}/
            chmod +x {{XBIN}}/typst.exe
            ;;
        *)
            cp $(find {{XBIN}}/tmp -type f -name typst) {{XBIN}}/
            chmod +x {{XBIN}}/typst
        ;;
    esac
    rm -rf {{XBIN}}/tmp
    {{XBIN}}/typst --version

fetch-pandoc:
    #!/bin/sh
    mkdir -p {{XBIN}}/tmp
    case "{{PANDOC_BASE}}" in
        *.tar.*)
            {{CURL}} -o {{XBIN}}/tmp/pandoc.tar.gz {{PANDOC_BASE}}
            (cd {{XBIN}}/tmp && tar -xf pandoc.tar.gz)
            ;;
        *.zip)
            {{CURL}} -o {{XBIN}}/tmp/pandoc.zip {{PANDOC_BASE}}
            (cd {{XBIN}}/tmp && unzip -o -j pandoc.zip)
        ;;
    esac
    case "{{os()}}" in
        windows)
            cp $(find {{XBIN}}/tmp -type f -name pandoc.exe) {{XBIN}}/
            chmod +x {{XBIN}}/pandoc.exe
            ;;
        *)
            cp $(find {{XBIN}}/tmp -type f -name pandoc) {{XBIN}}/
            chmod +x {{XBIN}}/pandoc
        ;;
    esac
    rm -rf {{XBIN}}/tmp
    {{XBIN}}/pandoc --version

fetch-rpgicons:
    #!/bin/sh
    rm -f {{XFNT}}/RpgGameIcons.otf {{XTMPL}}/diceset.typ
    {{CURL}} -o {{XFNT}}/RpgGameIcons.otf {{ICONS_FONT}}
    {{CURL}} -o {{XTMPL}}/diceset.typ {{ICONS_SET}}

fetch-noto:
    #!/bin/sh
    mkdir -p {{XFNT}}/noto/tmp
    for x in {{NOTO_BASE}}; do
        (cd {{XFNT}}/noto/tmp && {{CURL}} $x -o {{XFNT}}/noto/tmp/noto.zip && unzip -o -j noto.zip)
    done
    for x in {{NOTO_LIST}}; do
        cp {{XFNT}}/noto/tmp/$x {{XFNT}}/noto/
    done
    rm -rf {{XFNT}}/noto/tmp

fetch-luciole:
    #!/bin/sh
    echo "{{XDIR}}"
    mkdir -p {{XFNT}}/luciole/tmp
    for x in {{LUCIOLE_BASE}}; do
        (cd {{XFNT}}/luciole/tmp && {{CURL}} $x -o $(basename $x) && unzip -o -j *.zip L*.ttf)
    done
    (cd {{XFNT}}/luciole/tmp && cp *.ttf {{XFNT}}/luciole/)
    rm -rvf {{XFNT}}/luciole/tmp

fetch-res:
    #!/bin/sh -x
    for x in $(grep -v '^#' < {{XDIR}}/resources.fonts); do
        url=${x%%,*}
        name=${x##*,}
        match=${x%,*}
        match=${match#*,}
        match=${match:-?[tT][fF]}
        file=
        mkdir -p {{XFNT}}/$name/tmp
        case "$url" in
             *.zip)
                 ext=.zip
                 ;;
             *.tar.gz|*.tgz)
                 ext=.tar.gz
                 ;;
             *.tar.xz|*.txz)
                 ext=.tar.xz
                 ;;
             *.tar)
                 ext=.tar
                 ;;
             *.ttf|*.TTF)
                 ext=.ttf
                 file=$(basename $url)
                 ;;
             *.otf|*.OTF)
                 ext=.otf
                 file=$(basename $url)
                 ;;
             *)
                 ext=.none
                 ;;
        esac
        file=${file:-$name$ext}
        {{CURL}} -o {{XFNT}}/$name/tmp/$file "$url"
        case "$ext" in
              .zip)
                  (cd {{XFNT}}/$name/tmp/ && unzip -o -j $name$ext)
                  ;;
              .tar*)
                  (cd {{XFNT}}/$name/tmp/ && tar -xvf $name$ext)
                  ;;
        esac
        (cd {{XFNT}}/$name/tmp/ && detox -rv *)
        cp -v $(find {{XFNT}}/$name/tmp/ -name '*.'$match |fgrep -v -- -Variable) {{XFNT}}/$name/
        rm -rf {{XFNT}}/$name/tmp
    done

TYPST_PACKAGES := '''
    gentle-clues:1.2.0:
    linguify:0.4.2:
    elembic:1.0.0:
    cetz:0.4.2:
    oxifmt:1.0.0:
    cetz-plot:0.1.3:
    tiaoma:0.3.0:
    based:0.2.0:
'''

fetch-packages:
    #!/bin/sh
    _START=$(date)
    ## {{CURL}} https://packages.typst.org/preview/index.json |jq -c -r '.[] | .name+":"+.version+":"+((.categories|tostring) // "")'
    echo "{{TYPST_PACKAGES}}" | \
    while read -r line; do
        _NAME=$(echo "$line"|cut -f1 -d:)
        _VER=$(echo "$line"|cut -f2 -d:)
        if [ ! -z $_NAME ]; then
            _FILE="$_NAME-$_VER.tar.gz"
            echo "$line"
            mkdir -p {{XLIB}}/typst/preview/$_NAME/$_VER/
            cd {{XLIB}}/typst/preview/ && [ -f $_FILE ] || {{CURL}} -o $_FILE https://packages.typst.org/preview/$_FILE
            cd {{XLIB}}/typst/preview/$_NAME/$_VER/ && tar -xf {{XLIB}}/typst/preview/$_FILE -C {{XLIB}}/typst/preview/$_NAME/$_VER/
        fi
    done
    _END=$(date)
    echo ">>> $_START"
    echo "<<< $_END"


install: install-xbin install-fonts install-packages

install-xbin: fetch-typst fetch-pandoc fetch-utpm

install-packages: fetch-packages

install-fonts: fetch-noto fetch-luciole  fetch-rpgicons fetch-res

