#!/usr/bin/env -S just --justfile
#
#
# https://github.com/casey/just/releases/download/1.40.0/just-1.40.0-x86_64-unknown-linux-musl.tar.gz

CURL := 'curl --progress-bar -L '
XDIR := justfile_directory()
XBIN := XDIR+"/xbin"
XLIB := XDIR+"/lib"
ABIN := XBIN+"/"+arch()+"-"+os()
XTMP := XDIR+"/temp"
XFNT := XDIR+"/fonts"
XTMPL := XDIR+"/templates"

ICONS_FONT := 'https://github.com/terefang/rpg-icons-font/raw/refs/heads/main/static/RpgGameIcons.otf'
ICONS_SET := 'https://github.com/terefang/rpg-icons-font/raw/refs/heads/main/static/diceset.typ'
ICONS_NAMES := 'https://github.com/terefang/rpg-icons-font/raw/refs/heads/main/static/diceset.names'

## https://github.com/justrajdeep/fonts
## 0.2.0/

XBINARCH := arch()+'-'+os()

TYPST_NEXT := 'https://github.com/typst-community/dev-builds/releases/download/typst-main.2025-11-14.0da0165/typst-x86_64-unknown-linux-musl.tar.xz'

#TYPST_RELEASE := 'v0.14.1'
TYPST_RELEASE := 'v0.14.2'
TYPST_RELEASE_N1 := 'v0.13.1'
TYPST_RELEASE_N2 := 'v0.12.0'
TYPST_BASE := 'https://github.com/typst/typst/releases/download'
TYPST_PKG := if os() == "linux" {
if arch() == "x86_64" {
  'typst-x86_64-unknown-linux-musl.tar.xz'
} else {
 'typst-aarch64-unknown-linux-musl.tar.xz'
}
} else if os() == "macos" {
if arch() == "x86_64" {
  'typst-x86_64-apple-darwin.tar.xz'
} else {
 'typst-aarch64-apple-darwin.tar.xz'
}
} else { "." }

PANDOC_RELEASE := '3.8.3'
PANDOC_RELEASE_N1 := '3.8.2.1'
PANDOC_RELEASE_N2 := '3.7.0.2'
PANDOC_RELEASE_N3 := '3.6.4'
PANDOC_BASE := 'https://github.com/jgm/pandoc/releases/download'
PANDOC_PKG := if os() == "linux" {
if arch() == "x86_64" {
   '-linux-amd64.tar.gz'
} else {
  '-linux-arm64.tar.gz'
}
} else if os() == "macos" {
if arch() == "x86_64" {
   '-x86_64-macOS.zip'
} else {
  '-arm64-macOS.zip'
}
} else { "." }

NOTO_BASE := 'https://github.com/notofonts/latin-greek-cyrillic/releases/download/NotoSans-v2.015/NotoSans-v2.015.zip'
NOTO_LIST := 'NotoSans-BoldItalic.ttf ' \
    + 'NotoSans-Bold.ttf ' \
    + 'NotoSans-Italic.ttf ' \
    + 'NotoSans-Regular.ttf ' \
    + 'NotoSans-Black.ttf ' \
    + 'NotoSans-BlackItalic.ttf ' \
    + 'NotoSans-CondensedBlack.ttf ' \
    + 'NotoSans-CondensedBlackItalic.ttf ' \
    + 'NotoSans-CondensedBoldItalic.ttf ' \
    + 'NotoSans-CondensedBold.ttf ' \
    + 'NotoSans-CondensedItalic.ttf ' \
    + 'NotoSans-Condensed.ttf '

show:
    @echo 'XDG CACHE = {{ cache_directory() }} '
    @echo 'XDG CONFIG = {{ config_directory() }} '
    @echo 'XDG LOCAL CONFIG = {{ config_local_directory() }} '
    @echo 'XDG DATA = {{ data_directory() }} '
    @echo 'XDG LOCAL DATA = {{ data_local_directory() }} '
    @echo 'XDG EXECUTABLE = {{ executable_directory() }} '
    @echo 'HOME = {{ home_directory() }} '

fonts-list:
    {{XBIN}}/typst fonts --ignore-system-fonts --font-path {{XFNT}}

fonts-variants:
    {{XBIN}}/typst fonts --ignore-system-fonts --font-path {{XFNT}} --variants

fetch-xbin: fetch-typst fetch-pandoc

fetch-typst: (fetch-typst-version TYPST_RELEASE)

fetch-typst-known: \
    fetch-typst-next \
    (fetch-typst-version TYPST_RELEASE) \
    (fetch-typst-version TYPST_RELEASE_N1) \
    (fetch-typst-version TYPST_RELEASE_N2)

fetch-typst-next:
    #!/bin/sh
    mkdir -p {{XBIN}}/tmp
    case "{{TYPST_NEXT}}" in
        *.tar.*)
            {{CURL}} -o {{XBIN}}/tmp/typst.tar.xz "{{TYPST_NEXT}}"
            (cd {{XBIN}}/tmp && tar -xf typst.tar.xz)
            ;;
        *.zip)
            {{CURL}} -o {{XBIN}}/tmp/typst.zip  "{{TYPST_NEXT}}"
            (cd {{XBIN}}/tmp && unzip -o -j typst.zip)
        ;;
    esac
    case "{{os()}}" in
        windows)
            cp $(find {{XBIN}}/tmp -type f -name typst.exe) {{XBIN}}/
            chmod +x {{XBIN}}/typst.exe && mv {{XBIN}}/typst.exe {{XBIN}}/typst-next.exe
            ;;
        *)
            cp $(find {{XBIN}}/tmp -type f -name typst) {{XBIN}}/
            chmod +x {{XBIN}}/typst && mv {{XBIN}}/typst {{XBIN}}/typst-next
        ;;
    esac
    rm -rf {{XBIN}}/tmp
    {{XBIN}}/typst-next --version

fetch-typst-version _VERSION:
    #!/bin/sh
    mkdir -p {{XBIN}}/tmp
    case "{{TYPST_PKG}}" in
        *.tar.*)
            {{CURL}} -o {{XBIN}}/tmp/typst.tar.xz "{{TYPST_BASE}}/{{_VERSION}}/{{TYPST_PKG}}"
            (cd {{XBIN}}/tmp && tar -xf typst.tar.xz)
            ;;
        *.zip)
            {{CURL}} -o {{XBIN}}/tmp/typst.zip  "{{TYPST_BASE}}/{{_VERSION}}/{{TYPST_PKG}}"
            (cd {{XBIN}}/tmp && unzip -o -j typst.zip)
        ;;
    esac
    case "{{os()}}" in
        windows)
            cp $(find {{XBIN}}/tmp -type f -name typst.exe) {{XBIN}}/
            chmod +x {{XBIN}}/typst.exe && mv {{XBIN}}/typst.exe {{XBIN}}/typst-{{_VERSION}}-{{XBINARCH}}.exe
            ;;
        *)
            cp $(find {{XBIN}}/tmp -type f -name typst) {{XBIN}}/
            chmod +x {{XBIN}}/typst && mv {{XBIN}}/typst {{XBIN}}/typst-{{_VERSION}}-{{XBINARCH}}
        ;;
    esac
    rm -rf {{XBIN}}/tmp
    {{XBIN}}/typst-{{_VERSION}}-{{XBINARCH}} --version

fetch-pandoc: (fetch-pandoc-version PANDOC_RELEASE)

fetch-pandoc-known: \
    (fetch-pandoc-version PANDOC_RELEASE) \
    (fetch-pandoc-version PANDOC_RELEASE_N1) \
    (fetch-pandoc-version PANDOC_RELEASE_N2)

fetch-pandoc-version _VERSION:
    #!/bin/sh
    mkdir -p {{XBIN}}/tmp
    case "{{PANDOC_PKG}}" in
        *.tar.*)
            {{CURL}} -o {{XBIN}}/tmp/pandoc.tar.gz "{{PANDOC_BASE}}/{{_VERSION}}/pandoc-{{_VERSION}}{{PANDOC_PKG}}"
            (cd {{XBIN}}/tmp && tar -xf pandoc.tar.gz)
            ;;
        *.zip)
            {{CURL}} -o {{XBIN}}/tmp/pandoc.zip "{{PANDOC_BASE}}/{{_VERSION}}/pandoc-{{_VERSION}}{{PANDOC_PKG}}"
            (cd {{XBIN}}/tmp && unzip -o -j pandoc.zip)
        ;;
    esac
    case "{{os()}}" in
        windows)
            cp -v $(find {{XBIN}}/tmp -type f -name pandoc.exe) {{XBIN}}/
            chmod +x {{XBIN}}/pandoc.exe && mv {{XBIN}}/pandoc.exe {{XBIN}}/pandoc-{{_VERSION}}-{{XBINARCH}}.exe
            ;;
        *)
            cp -v $(find {{XBIN}}/tmp -type f -name pandoc) {{XBIN}}/
            chmod +x {{XBIN}}/pandoc && mv {{XBIN}}/pandoc {{XBIN}}/pandoc-{{_VERSION}}-{{XBINARCH}}
        ;;
    esac
    rm -rf {{XBIN}}/tmp
    {{XBIN}}/pandoc-{{_VERSION}}-{{XBINARCH}} --version

fetch-rpgicons:
    #!/bin/sh
    rm -f {{XFNT}}/RpgGameIcons.otf {{XTMPL}}/diceset.typ
    {{CURL}} -o {{XFNT}}/RpgGameIcons.otf {{ICONS_FONT}}
    {{CURL}} -o {{XTMPL}}/diceset.typ {{ICONS_SET}}
    {{CURL}} {{ICONS_NAMES}} |grep -v '^#'|awk '{print $1}' > {{XLIB}}/diceset.txt

fetch-noto:
    #!/bin/sh
    mkdir -p {{XFNT}}/noto/tmp
    for x in {{NOTO_BASE}}; do
        (cd {{XFNT}}/noto/tmp && {{CURL}} $x -o {{XFNT}}/noto/tmp/noto.zip && unzip -o -j noto.zip)
    done
    for x in {{NOTO_LIST}}; do
        cp {{XFNT}}/noto/tmp/$x {{XFNT}}/noto/
    done
    rm -rf {{XFNT}}/noto/tmp

fetch-to _listfile _prefix _grep:
    #!/bin/sh -x
    if [ -z "{{_grep}}" ]; then
        RESLIST=$(grep -v '^#' < {{_listfile}})
    else
        RESLIST=$(grep -v '^#' < {{_listfile}} |grep -P '{{_grep}}')
    fi
    for x in $RESLIST; do
        url=${x%%,*}
        name=${x##*,}
        match=${x%,*}
        match=${match#*,}
        match=.${match:-?[tT][fF]}
        file=
        mkdir -p {{_prefix}}/$name/tmp
        case "$url" in
             *.zip)
                 ext=.zip
                 ;;
             *.tar.gz|*.tgz)
                 ext=.tar.gz
                 ;;
             *.tar.xz|*.txz)
                 ext=.tar.xz
                 ;;
             *.tar)
                 ext=.tar
                 ;;
             *.ttf|*.TTF)
                 ext=.ttf
                 file=$(basename $url)
                 ;;
             *.otf|*.OTF)
                 ext=.otf
                 file=$(basename $url)
                 ;;
             *)
                 ext=
                 file=$(basename $url)
                 ;;
        esac
        file=${file:-$name$ext}
        {{CURL}} -o {{_prefix}}/$name/tmp/$file "$url"
        case "$ext" in
              .zip)
                  (cd {{_prefix}}/$name/tmp/ && unzip -o -j $name$ext)
                  ;;
              .tar*)
                  (cd {{_prefix}}/$name/tmp/ && tar -xvf $name$ext)
                  ;;
        esac
        (cd {{_prefix}}/$name/tmp/ && detox -rv *)
        rm -v $(find {{_prefix}}/$name/tmp/ -name '.*'$match )
        cp -v $(find {{_prefix}}/$name/tmp/ -name '*'$match ) {{_prefix}}/$name/
        rm -rf {{_prefix}}/$name/tmp
    done


fetch-res: (fetch-to XDIR+'/resources.fonts' XFNT '')

fetch-res-match _grep: (fetch-to XDIR+'/resources.fonts' XFNT _grep)

fetch-lib: (fetch-to XDIR+'/resources.lib' XLIB '')

fetch-packages:
    #!/bin/sh -x
    _START=$(date)
    _TPATH={{XLIB}}/mirror/typst/preview
    ## {{CURL}} https://packages.typst.org/preview/index.json |jq -c -r '.[] | .name+":"+.version+":"+((.categories|tostring) // "")'
    for line in $(grep -v '^#' < {{XDIR}}/resources.typst ); do
        _NAME=$(echo "$line"|cut -f1 -d:)
        _VER=$(echo "$line"|cut -f2 -d:)
        _PPATH=$_TPATH/$_NAME/$_VER/
        if [ ! -z $_NAME ]; then
            _FILE="$_NAME-$_VER.tar.gz"
            echo "$line"
            mkdir -p $_PPATH
            cd $_TPATH && [ -f $_FILE ] || {{CURL}} -o $_FILE https://packages.typst.org/preview/$_FILE
            #cd $_PPATH && tar -xf $_TPATH/$_FILE -C $_PPATH/
        fi
    done
    _END=$(date)
    echo ">>> $_START"
    echo "<<< $_END"


install: install-xbin install-fonts install-packages

install-xbin: fetch-xbin

install-packages: fetch-packages

install-fonts: fetch-noto fetch-rpgicons fetch-res